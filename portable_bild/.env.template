# Generated once by Start-Portable.bat if .env is not present.
# Edit this file (next to package.json) to change the runtime configuration;
# JWT_SECRET / JOB_SECRET are appended automatically with random values.
PORT=3800
AI_MODE=offline
CLOUD_AI_ENABLED=false

# ---- Local language model (llama.cpp, GGUF) --------------------------------
LOCAL_LLM_ENABLED=true
LOCAL_LLM_RUNTIME=llama.cpp
LOCAL_LLM_MODEL_PATH=./models/llm/model.gguf
LOCAL_LLM_CONTEXT_SIZE=4096
# Physical cores to use for generation (4 is safe on office PCs; raise on servers).
LOCAL_LLM_THREADS=4
# 0 = CPU only. Only set >0 on machines with a CUDA/Vulkan capable GPU + drivers.
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_MAX_TOKENS=512

# ---- Local embeddings (bge-m3, 1024-dim) ------------------------------------
# The installer ships models/embeddings/model.gguf; when the file is missing the
# app automatically falls back to keyword-only (Persian FTS) retrieval.
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL_PATH=./models/embeddings/model.gguf
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_CONTEXT_SIZE=1024

# ---- Storage ----------------------------------------------------------------
# The portable database is PGlite (PostgreSQL + pgvector in WASM) and is stored
# inside this folder. Back up the whole `storage` directory while the app is closed.
PORTABLE_DATABASE_DIR=./storage/database
STORAGE_DIR=./storage/files

# ---- Ingestion / performance (see .env.example for the full list) ----------
# Parallel document ingestion (raise to 4-8 for text-only corpora on 8+ cores).
INGEST_CONCURRENCY=2
INGEST_POLL_INTERVAL_MS=1000
MAINTENANCE_INTERVAL_MINUTES=30
RATE_LIMIT_UPLOAD_MAX=300
AUTH_CACHE_TTL_MS=30000
SESSION_DURATION_HOURS=8

# ---- Network ----------------------------------------------------------------
# 127.0.0.1 = this computer only. Use 0.0.0.0 to serve other PCs on the LAN
# (then open the Windows Firewall port and consider a reverse proxy with TLS).
PORTABLE_HOSTNAME=127.0.0.1
