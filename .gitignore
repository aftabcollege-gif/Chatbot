# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment files (secrets)
.env
.env.local
.env.production

# Local storage (uploaded files, temp data)
storage/

# Large AI model files — install them with `node scripts/install-model.mjs`
models/llm/*.gguf
models/embeddings/*.gguf
models/reranker/*.gguf
models/ocr/tessdata/*.traineddata.gz
models/ocr/tessdata/.tmp-*

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/

# TypeScript build info
*.tsbuildinfo

# Local scratch / benchmark databases
.scratch/

# Portable / installer build outputs (generated by portable_setup/build-installer.ps1)
portable_setup/release/
portable_setup/Output/
portable_setup/*.exe
portable_setup/*.bin
portable_bild/runtime/
portable_bild/poppler/
