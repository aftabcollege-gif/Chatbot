{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnterpriseAI",
  "version": "1.0.0",
  "identifier": "com.enterpriseai.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devFrontendDist": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "دستیار هوشمند سازمانی",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:8741 http://localhost:8741; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["bin/backend-server", "bin/llama-server"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Persian"]
      }
    }
  }
}
