{
  "name": "enterprise-ai-desktop-electron",
  "version": "1.0.0",
  "description": "دستیار هوشمند سازمانی — پوسته دسکتاپ مستقل آفلاین",
  "author": "Enterprise AI",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env EAI_DEV=1 electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.enterpriseai.assistant",
    "productName": "Chatbot Enterprise",
    "artifactName": "Chatbot-Enterprise-${version}-${arch}.${ext}",
    "directories": {
      "output": "../dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "splash.html"
    ],
    "extraResources": [
      { "from": "../backend/dist/backend-server", "to": "backend", "filter": ["**/*"] },
      { "from": "../frontend/dist", "to": "frontend/dist", "filter": ["**/*"] },
      { "from": "../config", "to": "config", "filter": ["**/*"] },
      { "from": "../llm", "to": "llm", "filter": ["**/*"] },
      { "from": "../models", "to": "models", "filter": ["**/*"] },
      { "from": "../extensions", "to": "extensions", "filter": ["**/*"] },
      { "from": "../prerequisites", "to": "prerequisites", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chatbot Enterprise"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "دستیار هوشمند سازمانی",
      "include": "installer.nsh"
    }
  }
}
