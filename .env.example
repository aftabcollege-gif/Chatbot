# ============================================================
# Server (used by portable_bild/start-portable.cjs; `next start` also
# honours PORT). PORTABLE_HOSTNAME=0.0.0.0 exposes the app on the LAN.
# ============================================================
PORT=3800
PORTABLE_HOSTNAME=127.0.0.1

# ============================================================
# Database
# ============================================================
# The app ships with an embedded PostgreSQL (PGlite) + pgvector. The database
# directory is created on first start and migrations (schema, pgvector, HNSW
# index, Persian text-search normaliser) run automatically.
PORTABLE_DATABASE_DIR=./storage/database

# ============================================================
# Auth (required)
# ============================================================
# Must be at least 32 characters long. The app FAILS FAST if it is missing.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Secret for the internal job-runner endpoint (/api/jobs/process).
# Must be at least 16 characters long.
JOB_SECRET=replace-with-a-long-random-job-secret

# ============================================================
# AI mode: offline | local | cloud   (default: offline)
#   offline -> local llama.cpp only, network kill-switch ON (recommended)
#   local   -> local llama.cpp, LAN localhost allowed, still no public internet
#   cloud   -> requires CLOUD_AI_ENABLED=true + OpenAI-compatible endpoint
# ============================================================
AI_MODE=offline
CLOUD_AI_ENABLED=false

# --- Local LLM (llama.cpp / node-llama-cpp) ---
# The runtime only uses the prebuilt binaries shipped in node_modules; it never
# compiles or downloads anything at runtime (NODE_LLAMA_CPP_SKIP_DOWNLOAD=true
# is set by the portable launcher and is a safe default everywhere).
NODE_LLAMA_CPP_SKIP_DOWNLOAD=true
LOCAL_LLM_ENABLED=true
LOCAL_LLM_RUNTIME=llama.cpp
# Install with: node scripts/install-model.mjs
LOCAL_LLM_MODEL_PATH=./models/llm/model.gguf
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=4
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_MAX_TOKENS=512

# --- Local Embedding model (bge-m3, 1024-dim) ---
# When enabled AND the model file exists, chunks are embedded and hybrid
# (vector + keyword) search is used. Otherwise search is keyword-only and
# no embedding work is done during ingestion (embedding column stays NULL;
# backfill later with `npm run reindex`).
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL_PATH=./models/embeddings/model.gguf
LOCAL_EMBEDDING_DIMENSIONS=1024
# Embedding context = max tokens per chunk (chunks are ~1000 chars); smaller
# is faster and uses less RAM.
LOCAL_EMBEDDING_CONTEXT_SIZE=1024
# Threads for the embedding model (default: LOCAL_LLM_THREADS).
# LOCAL_EMBEDDING_THREADS=4

# --- Optional cross-encoder reranker (e.g. bge-reranker-v2-m3 GGUF) ---
# When the file exists the top ~24 candidates are re-scored by the model.
LOCAL_RERANKER_MODEL_PATH=./models/reranker/model.gguf

# --- Cloud provider (ONLY used when AI_MODE=cloud) ---
# Use any OpenAI-compatible endpoint you have access to.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBED_MODEL=
AI_TEMPERATURE=0.1
EMBEDDING_DIMENSIONS=1536

# ============================================================
# RAG
# ============================================================
RAG_TOP_K=8
RAG_MIN_SCORE=0.15
# Max rows ranked per keyword-search level (bounds latency for very common
# terms in multi-million-chunk corpora).
RAG_KEYWORD_SCAN_CAP=5000

# ============================================================
# Ingestion worker (runs inside the app process)
# ============================================================
# Documents processed in parallel. With CPU embeddings keep 1–2 (the model is
# the bottleneck); for text-only ingestion 4–8 is fine on 8+ cores.
INGEST_CONCURRENCY=2
# Idle poll interval; new uploads wake the worker immediately anyway.
INGEST_POLL_INTERVAL_MS=1000
# Set to true if you want the app to NOT process the queue itself (e.g. you
# drain it with `npm run import -- <folder> --process` while the app is down).
# DISABLE_JOB_WORKER=false

# ============================================================
# Storage & uploads
# ============================================================
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=pdf,docx,xlsx,pptx,doc,txt,md,csv,rtf,odt,png,jpg,jpeg,tiff,bmp

# ============================================================
# Performance & housekeeping
# ============================================================
# Authenticated identity (session → user → roles → permissions) is cached
# in-process for this long; role/permission/user changes flush it instantly.
AUTH_CACHE_TTL_MS=30000
# Session lifetime for the auth cookie.
SESSION_DURATION_HOURS=8
# Fixed-window rate limits (per IP for login, per user for chat/upload).
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW_MINUTES=1
RATE_LIMIT_UPLOAD_MAX=300
RATE_LIMIT_UPLOAD_WINDOW_MINUTES=60
# Periodic maintenance (rate-limit/session purge, orphaned-job requeue,
# ANALYZE). First run ~20 s after boot, then every N minutes.
MAINTENANCE_INTERVAL_MINUTES=30
STALE_JOB_MINUTES=120
JOB_RETENTION_DAYS=30
